# =============================================================================
# MONVEXA - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to ".env".
# 2. Fill in the correct values for your specific environment.
# 3. Never commit your actual ".env" file to version control (GitHub/GitLab).
# 4. Restart the Vite development server after making changes.
#
# =============================================================================

# --- Supabase Configuration (Required) ---
# Find these in your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# --- Application Identity ---
VITE_APP_NAME=MONVEXA
VITE_APP_URL=http://localhost:5173
VITE_APP_CURRENCY=NGN
VITE_APP_TIMEZONE=Africa/Lagos
VITE_APP_VERSION=1.0.0

# --- Platform Rewards & Limits ---
# Welcome bonus amount credited to new wallets (Naira)
VITE_WELCOME_BONUS=500
# Percentage paid to referrers upon successful referral investment
VITE_REFERRAL_PERCENT=20
# Minimum amount allowed for a single withdrawal request (Naira)
VITE_MIN_WITHDRAWAL=1000

# --- Official Bank Account (Kuda Bank Only) ---
# Users transfer funds to this account for manual verification
VITE_BANK_NAME="Kuda Bank"
VITE_ACCOUNT_NAME="MONVEXA INVESTMENTS LTD"
VITE_ACCOUNT_NUMBER=0000000000

# --- Community & Support ---
# Official Telegram invitation link
VITE_TELEGRAM_GROUP=https://t.me/+soUYHDmaOZBmM2U0

# --- Development Settings ---
# Set to 'production' for live deployment
NODE_ENV=development
